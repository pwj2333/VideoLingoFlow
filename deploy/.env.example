COMPOSE_PROJECT_NAME=yunzhiai
API_IMAGE=ghcr.io/pwj2333/yunzhiai-api:latest
FRONTEND_IMAGE=ghcr.io/pwj2333/yunzhiai-frontend:latest
API_PORT=11001
HTTPS_PORT=443

# PyTorch 构建变体（传给 api.Dockerfile 的 --build-arg TORCH_INDEX）
#   cu128 : GPU 版（CUDA 12.8 运行库，由 PyTorch wheel 自带；运行时需 --gpus all）。默认。
#   cpu   : 纯 CPU 版（无 GPU 推理能力，镜像体积更小）
TORCH_INDEX=cu128

POSTGRES_DB=yunzhiai
POSTGRES_USER=yunzhiai
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_PORT=6379
VOICEFORGE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/2
VOICEFORGE_CELERY_RESULT_URL=redis://:${REDIS_PASSWORD}@redis:6379/3

MINIO_ROOT_USER=yunzhiai-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=yunzhiai-assets

TLS_CERT_FILE=./tls/fullchain.pem
TLS_KEY_FILE=./tls/privkey.pem
